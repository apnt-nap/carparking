{
  "expo": {
    "name": "Thai Mall Parking",
    "slug": "thai-mall-parking",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Turns your voice search into text.",
        "NSMicrophoneUsageDescription": "Lets you search for malls by voice."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shows malls near you and how far away they are."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Lets you search for malls by voice.",
          "speechRecognitionPermission": "Turns your voice search into text."
        }
      ]
    ],
    "scheme": "thaimallparking",
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b2193a87-3bba-4350-8daa-21c50afde24b"
      }
    },
    "owner": "apnt-nt",
    "updates": {
      "url": "https://u.expo.dev/b2193a87-3bba-4350-8daa-21c50afde24b"
    }
  }
}
